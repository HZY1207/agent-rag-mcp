# 复制为 .env 后按需修改：Copy-Item .env.example .env
# 字段名对应 app/core/config.py 中的配置项（大小写不敏感）

# ========== 应用 ==========
APP_NAME=AI Agent 智能助手平台
APP_VERSION=0.1.0
DEBUG=true

# ========== LLM（OpenAI 兼容接口；第 2 步起使用）==========
# 以 DeepSeek 为例；通义/智谱/OpenAI 等兼容 OpenAI 协议的服务都可以
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ========== 知识库 / RAG（第 3 步起使用）==========
# 本地向量模型（fastembed；首次使用自动下载，约几十 MB；代码已自动禁用 HF 的 Xet 后端）
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# HuggingFace 模型下载镜像（国内网络）；海外网络可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com
# 检索参数
KB_TOP_K=3
KB_SCORE_THRESHOLD=0.43

# ========== 工程化（第 9 步）==========
# 语义缓存：相似问题直接复用历史回答（只缓存"单轮、无会话"的问题）
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.96
SEMANTIC_CACHE_TTL=3600
# 限流：每 IP 每分钟最多请求数（超出返回 429）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ========== 部署相关（默认值即可；Docker 部署时由 compose 覆盖）==========
# 向量库连接方式：留空 = 本地文件模式；填写则走服务端模式
# QDRANT_URL=http://qdrant:6333
# 向量模型缓存目录（Docker 里挂卷用；留空 = 系统默认）
# FASTEMBED_CACHE_PATH=
# MCP 配置文件 / 会话数据库路径
# MCP_CONFIG_PATH=./mcp_servers.json
# SESSION_DB=./data/sessions.sqlite3
